{
  "name": "valley",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "The Valley: steward a valley over years. Every household can say no.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-release.ts && vite build",
    "preview": "vite preview",
    "test": "node scripts/suite-lock.ts -- vitest run --testTimeout=120000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "check:lane": "npm run check",
    "check:unused": "knip"
  },
  "dependencies": {
    "@adam0white/human-framework": "3.0.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.10.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.11.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "knip": "6.43.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    },
    "@adam0white/human-framework": "$@adam0white/human-framework"
  }
}
