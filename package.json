{
  "name": "valley",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "The Valley: steward a valley over years. Every household can say no.",
  "license": "MIT",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stamp-release.ts && vite build",
    "preview": "vite preview",
    "test": "node scripts/suite-lock.ts -- vitest run --testTimeout=120000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check . --error-on-warnings",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "deploy": "pnpm run check && pnpm run build && pnpm exec wrangler deploy",
    "check:lane": "pnpm run check",
    "check:unused": "knip"
  },
  "dependencies": {
    "@adam0white/human-framework": "3.0.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.11.tgz",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.12.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "knip": "6.43.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    },
    "@adam0white/human-framework": "$@adam0white/human-framework"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
